{
  "AllowedHosts": "*",
  "Auth": {
    "FrontendBaseUrl": "https://chitu.konnokai.me",
    "PublicApiBaseUrl": "https://chitu-api.konnokai.me",
    "CookieName": "chitu.auth",
    "CookieHours": 4,
    "CookieSameSite": "Lax"
  },
  "DataProtection": {
    "KeysPath": "/keys"
  },
  "ForwardedHeaders": {
    "KnownProxies": "127.0.0.1"
  },
  "Discord": {
    "BotToken": "",
    "ClientId": "",
    "ClientSecret": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
